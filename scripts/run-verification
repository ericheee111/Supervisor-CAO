#!/usr/bin/env python3
"""run-verification: deterministic remote verification runner (spec §13, §14).

Runs remote verification as a single try/finally transaction:
  select container -> acquire owner lock -> check clean -> record git state
  -> checkout candidate -> run configured verification commands -> restore
  git state -> verify restoration -> release lock (same owner only).

The verification commands are NOT hard-coded here. They come from:
  - the project config's ``default_verification.remote`` steps, OR
  - the ``--verify-command`` argument (repeatable), OR
  - a ``--verify-script`` file run inside the container.

The platform core only reads this script's exit code and the structured
verification.json it writes. Failure handling:
  - stale lock: detect and refuse (don't delete someone else's lock)
  - restore failure: keep lock, mark container UNHEALTHY
  - never reset --hard, never clean -fdx

Usage:
  run-verification --ssh-host H --container C --user U --repo-path P \\
      --candidate-sha SHA --task-id T [--run-dir PATH] \\
      [--verify-command 'CMD'] [--verify-script FILE] \\
      [--setup-command 'CMD'] [--env KEY=VAL]...
"""
from __future__ import annotations

import argparse
import json
import os
import shlex
import subprocess
import sys
import time
from pathlib import Path

RUN_ROOT = Path.home() / "cao-runs"


def _ssh(ssh_host: str, cmd: str, timeout: int = 60) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["ssh", "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=accept-new",
         "-o", "ConnectTimeout=10", ssh_host, cmd],
        capture_output=True, text=True, timeout=timeout,
    )


def _in_container(ssh_host: str, container: str, user: str, cmd: str,
                  timeout: int = 600) -> subprocess.CompletedProcess:
    user_prefix = f"sudo -u {user} " if user and user != "root" else ""
    inner = f"docker exec {container} {user_prefix}bash -lc {shlex.quote(cmd)}"
    return _ssh(ssh_host, inner, timeout=timeout)


def _acquire_lock(ssh_host: str, container: str, task_id: str,
                  candidate_sha: str | None = None) -> bool:
    """Atomically acquire lock with owner=task_id. Returns False if already locked
    by a DIFFERENT owner (does NOT delete others' locks). Detects stale locks."""
    lock_file = f"/tmp/scao-{container}.lock"
    info = json.dumps({"task_id": task_id, "ts": time.time(), "sha": candidate_sha,
                       "pid": os.getpid()})
    r = _ssh(ssh_host,
             f"(set -o noclobber; echo '{info}' > {lock_file}) 2>/dev/null && echo ACQUIRED || echo TAKEN",
             timeout=20)
    if r.returncode == 0 and "ACQUIRED" in r.stdout:
        return True
    r2 = _ssh(ssh_host, f"cat {lock_file} 2>/dev/null || echo EMPTY", timeout=15)
    try:
        owner_info = json.loads(r2.stdout.strip())
        if owner_info.get("task_id") == task_id:
            return True
        lock_ts = owner_info.get("ts", 0)
        if time.time() - lock_ts > 7200:
            r3 = _ssh(ssh_host,
                      f"echo '{info}' > {lock_file} 2>/dev/null && echo ACQUIRED || echo TAKEN",
                      timeout=15)
            return r3.returncode == 0 and "ACQUIRED" in r3.stdout
    except (json.JSONDecodeError, TypeError):
        pass
    return False


def _release_lock(ssh_host: str, container: str, task_id: str) -> bool:
    """Release lock ONLY if owned by task_id. Never deletes others' locks."""
    lock_file = f"/tmp/scao-{container}.lock"
    r = _ssh(ssh_host, f"cat {lock_file} 2>/dev/null || echo EMPTY", timeout=15)
    try:
        owner_info = json.loads(r.stdout.strip())
        if owner_info.get("task_id") != task_id:
            return False
    except (json.JSONDecodeError, TypeError):
        return False
    r2 = _ssh(ssh_host, f"rm -f {lock_file} && echo RELEASED", timeout=20)
    return r2.returncode == 0 and "RELEASED" in r2.stdout


def main() -> int:
    ap = argparse.ArgumentParser(description="Remote verification runner")
    ap.add_argument("--ssh-host", required=True)
    ap.add_argument("--containers", required=True, help="comma-separated container names")
    ap.add_argument("--user", required=True)
    ap.add_argument("--repo-path", required=True)
    ap.add_argument("--candidate-sha", required=True)
    ap.add_argument("--task-id", required=True)
    ap.add_argument("--run-dir", default=None)
    # Configurable verification commands (NOT hard-coded pytest/ASV).
    ap.add_argument("--setup-command", action="append", default=[],
                    help="setup command to run in the container before verify (repeatable)")
    ap.add_argument("--verify-command", action="append", default=[],
                    help="verification command to run in the container (repeatable; ALL must pass)")
    ap.add_argument("--verify-script", default=None,
                    help="path to a script file copied into the container and run")
    ap.add_argument("--env", action="append", default=[],
                    help="environment variable KEY=VAL for the verify commands (repeatable)")
    args = ap.parse_args()

    containers = [c.strip() for c in args.containers.split(",") if c.strip()]
    container = containers[0] if containers else ""

    run_dir = Path(args.run_dir) if args.run_dir else RUN_ROOT / args.task_id
    run_dir.mkdir(parents=True, exist_ok=True)

    result = {"task_id": args.task_id, "container": container,
              "candidate_sha": args.candidate_sha, "started": time.time(), "stale": False}

    env_exports = ""
    for kv in args.env:
        if "=" in kv:
            k, v = kv.split("=", 1)
            env_exports += f"export {shlex.quote(k)}={shlex.quote(v)}; "

    # 1. reachability
    r = _ssh(args.ssh_host, f"docker inspect --format='{{{{.State.Running}}}}' {container}", timeout=20)
    if r.returncode != 0 or "true" not in r.stdout:
        result["status"] = "UNREACHABLE"
        result["error"] = r.stderr.strip()
        (run_dir / "verification.json").write_text(json.dumps(result, indent=2))
        print(json.dumps(result, indent=2))
        return 3

    # 2. acquire lock (owner = task_id)
    locked = _acquire_lock(args.ssh_host, container, args.task_id, args.candidate_sha)
    if not locked:
        result["status"] = "BUSY"
        result["error"] = "container locked by another task"
        (run_dir / "verification.json").write_text(json.dumps(result, indent=2))
        print(json.dumps(result, indent=2))
        return 5

    git_before: dict = {}
    try:
        # 3. record git state before
        for k, c in [("branch", "git rev-parse --abbrev-ref HEAD"),
                     ("head", "git rev-parse HEAD"),
                     ("porcelain", "git status --porcelain")]:
            rr = _in_container(args.ssh_host, container, args.user,
                               f"cd {args.repo_path} && {c}", timeout=25)
            git_before[k] = rr.stdout.strip() if rr.returncode == 0 else f"ERR:{rr.stderr.strip()}"
        (run_dir / "git-state-before.json").write_text(json.dumps(git_before, indent=2))

        if git_before.get("porcelain"):
            result["status"] = "REMOTE_WORKTREE_DIRTY"
            result["git_before"] = git_before
            result["restored"] = True
            _release_lock(args.ssh_host, container, args.task_id)
            result["finished"] = time.time()
            (run_dir / "verification.json").write_text(json.dumps(result, indent=2))
            print(json.dumps(result, indent=2))
            return 4

        # 4. fetch + checkout candidate (NO reset --hard, NO clean)
        for name, cmd in [("fetch", f"cd {args.repo_path} && git fetch origin"),
                          ("checkout", f"cd {args.repo_path} && git checkout {args.candidate_sha}"),
                          ("head_check", f"cd {args.repo_path} && git rev-parse HEAD")]:
            rr = _in_container(args.ssh_host, container, args.user, cmd, timeout=120)
            (run_dir / f"{name}.log").write_text(rr.stdout + rr.stderr)
            if name == "head_check":
                result["remote_head"] = rr.stdout.strip()
                if result["remote_head"] != args.candidate_sha:
                    result["status"] = "STALE_VERIFICATION"
                    result["stale"] = True

        # 5. setup commands (configurable; e.g. activate env, install)
        setup_results = []
        for i, cmd in enumerate(args.setup_command):
            full = f"{env_exports}cd {args.repo_path} && set -o pipefail && {cmd}"
            rr = _in_container(args.ssh_host, container, args.user, full, timeout=900)
            (run_dir / f"setup-{i}.log").write_text(rr.stdout + rr.stderr)
            setup_results.append({"command": cmd, "ok": rr.returncode == 0})
            if rr.returncode != 0:
                result["status"] = "FAILED"
                result["setup"] = setup_results
                break
        result["setup"] = setup_results

        # 6. verification commands (configurable). The exit code is authoritative.
        verify_results = []
        all_passed = result.get("status") != "FAILED"
        if all_passed and (args.verify_command or args.verify_script):
            cmds = list(args.verify_command)
            if args.verify_script:
                script_text = Path(args.verify_script).read_text()
                cmds.append(script_text)
            for i, cmd in enumerate(cmds):
                full = f"{env_exports}cd {args.repo_path} && set -o pipefail && {cmd}"
                rr = _in_container(args.ssh_host, container, args.user, full, timeout=1800)
                (run_dir / f"verify-{i}.log").write_text(rr.stdout + rr.stderr)
                ok = rr.returncode == 0
                verify_results.append({"command": cmd[:80], "ok": ok, "exit_code": rr.returncode})
                if not ok:
                    all_passed = False
                    break
        elif all_passed and not args.verify_command and not args.verify_script:
            # No verification commands configured: cannot claim verified.
            all_passed = False
            result["error"] = "no verify-command or verify-script configured"
        result["verify"] = verify_results
        result["verify_passed"] = all_passed

        if all_passed and result.get("status") != "STALE_VERIFICATION":
            result["status"] = "REMOTE_VERIFIED"
        elif "status" not in result:
            result["status"] = "FAILED"

    except Exception as e:
        result["status"] = result.get("status", "FAILED")
        result["error"] = str(e)

    finally:
        # 7. restore git state (NO reset --hard, NO clean -fdx)
        if git_before.get("branch") and git_before["branch"] != "ERR":
            _in_container(args.ssh_host, container, args.user,
                          f"cd {args.repo_path} && git checkout {shlex.quote(git_before['branch'])}",
                          timeout=30)
        git_after = {}
        for k, c in [("branch", "git rev-parse --abbrev-ref HEAD"),
                     ("head", "git rev-parse HEAD"),
                     ("porcelain", "git status --porcelain")]:
            rr = _in_container(args.ssh_host, container, args.user,
                               f"cd {args.repo_path} && {c}", timeout=25)
            git_after[k] = rr.stdout.strip() if rr.returncode == 0 else f"ERR:{rr.stderr.strip()}"
        (run_dir / "git-state-after.json").write_text(json.dumps(git_after, indent=2))
        restored = (git_after.get("head") == git_before.get("head")
                    and not git_after.get("porcelain", ""))

        if not restored:
            result["status"] = "UNHEALTHY"
            result["restored"] = False
            result["error"] = (result.get("error", "") +
                               f"; restore failed: head {git_after.get('head')} != {git_before.get('head')}")
        else:
            result["restored"] = True
            _release_lock(args.ssh_host, container, args.task_id)

        result["finished"] = time.time()
        (run_dir / "verification.json").write_text(json.dumps(result, indent=2))
        print(json.dumps(result, indent=2))

    return 0 if result.get("status") == "REMOTE_VERIFIED" else 1


if __name__ == "__main__":
    sys.exit(main())
