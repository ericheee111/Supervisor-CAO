#!/usr/bin/env python3
"""detect-models: detect OpenCode providers/models and emit a desensitized
models.local.yaml mapping for Supervisor-CAO.

Never prints or writes API keys. Reads only provider IDs and model IDs.

Usage:
    detect-models [--opencode-config DIR] [--out PATH] [--check]

Outputs ~/.config/supervisor-cao/models.local.yaml by default, containing only
provider/model IDs and the role-to-model mapping (no secrets).
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

DEFAULT_OUT = Path.home() / ".config" / "supervisor-cao" / "models.local.yaml"
DEFAULT_AUTH = Path.home() / ".local" / "share" / "opencode" / "auth.json"
# On WSL2 the OpenCode install may be shared from Windows; allow override via env.
WIN_AUTH = Path(os.environ.get("OPENCODE_AUTH_PATH", "")) if os.environ.get("OPENCODE_AUTH_PATH") else None

# Role -> (provider preference order, model-id matcher)
# Matchers are substring/regex on the model id (provider/model).
ROLE_SPECS = {
    "supervisor_primary": {
        "candidates": ["zhipuai/glm-5.2", "alibaba-cn/qwen3.7-max"],
        "label": "GLM 5.2",
    },
    "supervisor_backup": {
        "candidates": ["alibaba-cn/qwen3.7-max", "zhipuai/glm-5.2"],
        "label": "Qwen 3.7 Max",
    },
    "glm_executor": {
        "candidates": ["zhipuai/glm-5.2", "alibaba-cn/glm-5.2"],
        "label": "GLM 5.2",
    },
    "qwen_verifier": {
        "candidates": ["alibaba-cn/qwen3.7-max", "alibaba-cn/qwen3-max", "alibaba-cn/qwen-plus"],
        "label": "Qwen",
    },
    "researcher": {
        "candidates": ["zhipuai/glm-5.2", "alibaba-cn/qwen3.7-max"],
        "label": "GLM/Qwen cheap",
    },
}


def find_auth_json(opencode_config: str | None) -> Path | None:
    candidates: list[Path] = []
    if opencode_config:
        candidates.append(Path(opencode_config) / "auth.json")
    candidates.append(DEFAULT_AUTH)
    if WIN_AUTH is not None:
        candidates.append(WIN_AUTH)
    for c in candidates:
        if c.exists():
            return c
    return None


def read_providers(auth_path: Path) -> list[str]:
    """Return provider IDs only (never values)."""
    try:
        data = json.loads(auth_path.read_text())
    except Exception as e:
        print(f"WARN: could not read {auth_path}: {e}", file=sys.stderr)
        return []
    if isinstance(data, dict):
        return sorted(k for k, v in data.items() if isinstance(v, dict))
    return []


def list_opencode_models() -> list[str]:
    """Call `opencode models` and parse the lines."""
    try:
        out = subprocess.run(
            ["opencode", "models"], capture_output=True, text=True, timeout=30
        )
    except Exception as e:
        print(f"WARN: opencode models failed: {e}", file=sys.stderr)
        return []
    models = []
    for line in out.stdout.splitlines():
        line = line.strip()
        if "/" in line and not line.startswith("opencode/"):
            models.append(line)
        elif "/" in line:
            # include opencode/* free models too but tag separately
            models.append(line)
    return models


def pick_model(available: list[str], candidates: list[str]) -> str | None:
    avail = set(available)
    for c in candidates:
        if c in avail:
            return c
    # fuzzy: match by suffix
    for c in candidates:
        suffix = c.split("/", 1)[-1]
        for a in available:
            if a.split("/", 1)[-1] == suffix:
                return a
    return None


def build_mapping(providers: list[str], models: list[str]) -> dict:
    mapping = {"providers": providers, "models_available_count": len(models)}
    roles = {}
    for role, spec in ROLE_SPECS.items():
        chosen = pick_model(models, spec["candidates"])
        roles[role] = {"model": chosen, "label": spec["label"], "configured": chosen is not None}
    mapping["roles"] = roles
    # codex is separate (Codex CLI, ChatGPT auth) - not an OpenCode provider
    mapping["codex"] = {"platform": "codex-cli", "auth": "chatgpt", "configured": True}
    return mapping


def to_yaml(data: dict) -> str:
    """Tiny YAML emitter for this flat-ish structure (no external deps)."""
    lines = ["# models.local.yaml - desensitized provider/model mapping for Supervisor-CAO",
             "# Generated by scripts/detect-models. Contains NO API keys.",
             "# DO NOT COMMIT (already in .gitignore).",
             ""]
    lines.append(f"providers:  # OpenCode provider IDs detected")
    for p in data.get("providers", []):
        lines.append(f"  - {p}")
    lines.append(f"models_available_count: {data.get('models_available_count', 0)}")
    lines.append("")
    lines.append("roles:")
    for role, info in data.get("roles", {}).items():
        lines.append(f"  {role}:")
        m = info.get("model")
        lines.append(f"    model: {m if m else 'null'}")
        lines.append(f"    label: {info.get('label', '')}")
        lines.append(f"    configured: {str(info.get('configured', False)).lower()}")
    lines.append("")
    lines.append("codex:")
    for k, v in data.get("codex", {}).items():
        lines.append(f"  {k}: {v}")
    return "\n".join(lines) + "\n"


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--opencode-config", default=None, help="OpenCode config dir")
    ap.add_argument("--out", default=str(DEFAULT_OUT), help="output yaml path")
    ap.add_argument("--check", action="store_true", help="only print detection result, do not write")
    args = ap.parse_args()

    auth_path = find_auth_json(args.opencode_config)
    providers = read_providers(auth_path) if auth_path else []
    print(f"auth file: {auth_path}", file=sys.stderr)
    print(f"providers detected (IDs only): {providers}", file=sys.stderr)

    models = list_opencode_models()
    print(f"models listed by opencode: {len(models)}", file=sys.stderr)

    mapping = build_mapping(providers, models)
    yaml_text = to_yaml(mapping)

    if args.check:
        print(yaml_text)
        # exit non-zero if any role unconfigured
        unconf = [r for r, info in mapping["roles"].items() if not info["configured"]]
        if unconf:
            print(f"ERROR: unconfigured roles: {unconf}", file=sys.stderr)
            return 2
        return 0

    out = Path(args.out)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(yaml_text)
    print(f"wrote {out}", file=sys.stderr)
    unconf = [r for r, info in mapping["roles"].items() if not info["configured"]]
    return 2 if unconf else 0


if __name__ == "__main__":
    sys.exit(main())
