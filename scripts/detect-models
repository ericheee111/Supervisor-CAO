#!/usr/bin/env python3
"""detect-models: detect OpenCode providers/models and emit a desensitized
models.local.yaml mapping for Supervisor-CAO.

Never prints or writes API keys. Reads only provider IDs and model IDs.

Usage:
    detect-models [--opencode-config DIR] [--out PATH] [--check]

Outputs ~/.config/supervisor-cao/models.local.yaml by default, containing only
provider/model IDs and the role-to-model mapping (no secrets).
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

DEFAULT_OUT = Path.home() / ".config" / "supervisor-cao" / "models.local.yaml"
DEFAULT_AUTH = Path.home() / ".local" / "share" / "opencode" / "auth.json"
# On WSL2 the OpenCode install may be shared from Windows; allow override via env.
WIN_AUTH = Path(os.environ.get("OPENCODE_AUTH_PATH", "")) if os.environ.get("OPENCODE_AUTH_PATH") else None

# Candidate model ids are NOT hard-coded here. They are read from a local
# (gitignored) candidates file so the public source contains no specific model
# ids. The file maps role -> ordered list of candidate "provider/model" ids.
# If absent, detection lists available models without preferring any.
CANDIDATES_FILE = Path.home() / ".config" / "supervisor-cao" / "model-candidates.yaml"

# OpenCode roles only. Planner/Reviewer/Judge use Codex CLI (separate health
# check), NOT OpenCode model mappings. These role keys match
# model_resolver.PROFILE_TO_ROLE values for the OpenCode profiles.
OPENCODE_ROLE_LABELS = {
    "supervisor_primary": "primary supervisor model",
    "supervisor_backup": "backup supervisor model",
    "executor": "executor model",
    "verifier": "verifier model",
    "research": "researcher model",
}

# Codex roles are checked via the Codex CLI health check, not OpenCode models.
CODEX_ROLES = ["planner", "reviewer", "judge"]


def _load_role_specs() -> dict:
    """Load role -> candidate model list from the local candidates file.

    Only OpenCode roles are loaded (supervisor_primary, supervisor_backup,
    executor, verifier, research). Codex roles (planner/reviewer/judge) are
    NOT loaded here — they use a Codex CLI health check instead.
    """
    if not CANDIDATES_FILE.exists():
        return {role: {"candidates": [], "label": lbl}
                for role, lbl in OPENCODE_ROLE_LABELS.items()}
    try:
        import yaml
        data = yaml.safe_load(CANDIDATES_FILE.read_text()) or {}
    except Exception:
        return {role: {"candidates": [], "label": lbl}
                for role, lbl in OPENCODE_ROLE_LABELS.items()}
    specs = {}
    for role, lbl in OPENCODE_ROLE_LABELS.items():
        cands = data.get(role, [])
        if isinstance(cands, str):
            cands = [cands]
        specs[role] = {"candidates": list(cands or []), "label": lbl}
    return specs


def codex_cli_healthy() -> bool:
    """Check the Codex CLI is installed and authenticated.

    Planner/Reviewer/Judge use Codex CLI (ChatGPT auth), NOT OpenCode model
    mappings. This returns True if `codex --version` succeeds.
    """
    try:
        r = subprocess.run(["codex", "--version"], capture_output=True,
                           text=True, timeout=15)
        return r.returncode == 0
    except Exception:
        return False


def find_auth_json(opencode_config: str | None) -> Path | None:
    candidates: list[Path] = []
    if opencode_config:
        candidates.append(Path(opencode_config) / "auth.json")
    candidates.append(DEFAULT_AUTH)
    if WIN_AUTH is not None:
        candidates.append(WIN_AUTH)
    for c in candidates:
        if c.exists():
            return c
    return None


def read_providers(auth_path: Path) -> list[str]:
    """Return provider IDs only (never values)."""
    try:
        data = json.loads(auth_path.read_text())
    except Exception as e:
        print(f"WARN: could not read {auth_path}: {e}", file=sys.stderr)
        return []
    if isinstance(data, dict):
        return sorted(k for k, v in data.items() if isinstance(v, dict))
    return []


def list_opencode_models() -> list[str]:
    """Call `opencode models` and parse the lines."""
    try:
        out = subprocess.run(
            ["opencode", "models"], capture_output=True, text=True, timeout=30
        )
    except Exception as e:
        print(f"WARN: opencode models failed: {e}", file=sys.stderr)
        return []
    models = []
    for line in out.stdout.splitlines():
        line = line.strip()
        if "/" in line and not line.startswith("opencode/"):
            models.append(line)
        elif "/" in line:
            # include opencode/* free models too but tag separately
            models.append(line)
    return models


def pick_model(available: list[str], candidates: list[str]) -> str | None:
    avail = set(available)
    for c in candidates:
        if c in avail:
            return c
    # fuzzy: match by suffix
    for c in candidates:
        suffix = c.split("/", 1)[-1]
        for a in available:
            if a.split("/", 1)[-1] == suffix:
                return a
    return None


def build_mapping(providers: list[str], models: list[str]) -> dict:
    specs = _load_role_specs()
    mapping = {"providers": providers, "models_available_count": len(models)}
    # Flat role -> model-id mapping for OpenCode roles only. The value is a
    # STRING ("provider/model") or None, so model_resolver.resolve_model and
    # install-profiles can read it directly via isinstance(..., str).
    roles = {}
    roles_meta = {}
    for role, spec in specs.items():
        chosen = pick_model(models, spec["candidates"])
        roles[role] = chosen  # string or None
        roles_meta[role] = {"label": spec["label"], "configured": chosen is not None}
    mapping["roles"] = roles
    mapping["roles_meta"] = roles_meta
    # Codex roles (planner/reviewer/judge) use the Codex CLI, NOT OpenCode
    # models. Health is checked via `codex --version`; no model mapping needed.
    codex_ok = codex_cli_healthy()
    mapping["codex"] = {"platform": "codex-cli", "healthy": codex_ok,
                        "roles": CODEX_ROLES}
    return mapping


def to_yaml(data: dict) -> str:
    """Tiny YAML emitter. Emits a flat role -> model-id mapping at the top level
    (each role key maps to a string model id or null), which model_resolver and
    install-profiles read directly."""
    lines = ["# models.local.yaml - desensitized provider/model mapping for Supervisor-CAO",
             "# Generated by scripts/detect-models. Contains NO API keys.",
             "# DO NOT COMMIT (already in .gitignore).",
             "# Each role key maps directly to a 'provider/model' string (or null).",
             "# Role keys match model_resolver.PROFILE_TO_ROLE values.",
             ""]
    lines.append("providers:  # OpenCode provider IDs detected")
    for p in data.get("providers", []):
        lines.append(f"  - {p}")
    lines.append(f"models_available_count: {data.get('models_available_count', 0)}")
    lines.append("")
    lines.append("# role -> model id (string) — read by model_resolver / install-profiles")
    for role, model in data.get("roles", {}).items():
        lines.append(f"{role}: {model if model else 'null'}")
    lines.append("")
    lines.append("# metadata only (not read by the platform; informational)")
    lines.append("roles_meta:")
    for role, info in data.get("roles_meta", {}).items():
        lines.append(f"  {role}:")
        lines.append(f"    label: {info.get('label', '')}")
        lines.append(f"    configured: {str(info.get('configured', False)).lower()}")
    lines.append("")
    lines.append("codex:")
    codex = data.get("codex", {})
    lines.append(f"  platform: {codex.get('platform', 'codex-cli')}")
    lines.append(f"  healthy: {str(codex.get('healthy', False)).lower()}")
    lines.append(f"  roles: {codex.get('roles', [])}")
    return "\n".join(lines) + "\n"


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--opencode-config", default=None, help="OpenCode config dir")
    ap.add_argument("--out", default=str(DEFAULT_OUT), help="output yaml path")
    ap.add_argument("--check", action="store_true", help="only print detection result, do not write")
    args = ap.parse_args()

    auth_path = find_auth_json(args.opencode_config)
    providers = read_providers(auth_path) if auth_path else []
    print(f"auth file: {auth_path}", file=sys.stderr)
    print(f"providers detected (IDs only): {providers}", file=sys.stderr)

    models = list_opencode_models()
    print(f"models listed by opencode: {len(models)}", file=sys.stderr)

    mapping = build_mapping(providers, models)
    yaml_text = to_yaml(mapping)

    if args.check:
        print(yaml_text)
        # exit non-zero if any OpenCode role unconfigured (model is None) or
        # the Codex CLI is not healthy (planner/reviewer/judge need it).
        unconf = [r for r, model in mapping["roles"].items() if not model]
        if unconf:
            print(f"ERROR: unconfigured OpenCode roles: {unconf}", file=sys.stderr)
            return 2
        if not mapping.get("codex", {}).get("healthy"):
            print("ERROR: Codex CLI not healthy (planner/reviewer/judge need it)",
                  file=sys.stderr)
            return 2
        return 0

    out = Path(args.out)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(yaml_text)
    print(f"wrote {out}", file=sys.stderr)
    unconf = [r for r, model in mapping["roles"].items() if not model]
    if unconf or not mapping.get("codex", {}).get("healthy"):
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
