#!/usr/bin/env python3
"""scan-secrets: pre-push secret / private-identifier scanner (spec §4).

Blocks push if it finds:
  - common API key formats (OpenAI, AWS, generic sk-/key-)
  - known internal host aliases, container names, usernames
  - private paths
  - .env, secrets.env, *.local.yaml, *.private.md
  - OpenCode/Codex auth/credential files

Exit 0 = clean, exit 1 = leak found (blocks push).
Designed to have NO third-party deps (gitleaks optional; this is the fallback).
"""
from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

# --- Patterns that indicate a leaked secret ---
SECRET_PATTERNS = [
    (re.compile(r"sk-[A-Za-z0-9]{20,}"), "OpenAI-style API key (sk-)"),
    (re.compile(r"AKIA[0-9A-Z]{16}"), "AWS access key ID"),
    (re.compile(r"(?i)api[_-]?key\s*[:=]\s*['\"][A-Za-z0-9_\-]{16,}['\"]"), "generic api_key assignment"),
    (re.compile(r"gh[pousr]_[A-Za-z0-9]{36,}"), "GitHub token (ghp_/gho_/ghu_/ghs_/ghr_)"),
    (re.compile(r"AIza[0-9A-Za-z_\-]{35}"), "Google API key"),
    (re.compile(r"(?i)bearer\s+[A-Za-z0-9_\-\.]{20,}"), "Bearer token"),
]

# --- Known private identifiers (must NEVER appear in public repo) ---
PRIVATE_IDENTIFIERS = [
    "kpserver",
    "ericheee-cpu200-203",
    "ericheee-cpu280-283",
    "h00932740",
    "ericheee111/Supervisor-CAO项目设计方案.private.md",
]

# --- Files that must never be committed ---
FORBIDDEN_FILES = [
    ".env", "secrets.env", "auth.json", "opencode.jsonc",
    "oh-my-openagent.json", "config.toml",
]
FORBIDDEN_SUFFIXES = [".local.yaml", ".local.yml", ".local.json", ".private.md"]

# --- Path substrings that indicate a private Windows/WSL path leak ---
PRIVATE_PATH_HINTS = [
    r"/mnt/c/Users/Administrator",
    r"/root/\.config/supervisor-cao",
    r"/root/projects/pandas",
    r"D:\\Projects\\pandas",
    r"/home/h00932740",
]

PRIVATE_PATH_RE = re.compile("|".join(PRIVATE_PATH_HINTS))


def scan_file(path: Path) -> list[str]:
    """Return list of findings (strings) for a file."""
    findings = []
    name = path.name
    # binary check
    try:
        text = path.read_text(encoding="utf-8", errors="strict")
    except (UnicodeDecodeError, ValueError):
        return []
    except OSError:
        return []

    for pat, label in SECRET_PATTERNS:
        for m in pat.finditer(text):
            findings.append(f"{path}: secret pattern {label}: {m.group(0)[:20]}...")
    for ident in PRIVATE_IDENTIFIERS:
        if ident in text:
            findings.append(f"{path}: private identifier '{ident}'")
    for m in PRIVATE_PATH_RE.finditer(text):
        findings.append(f"{path}: private path leak '{m.group(0)}'")
    return findings


def scan_repo(root: str) -> tuple[list[str], list[str]]:
    """Scan a repo root. Returns (file_findings, forbidden_file_list)."""
    root_path = Path(root)
    findings: list[str] = []
    forbidden: list[str] = []

    # respect .gitignore by skipping common ignore dirs (simple heuristic)
    skip_dirs = {".git", "__pycache__", ".cache", "cao-src", "wheels", "node_modules",
                 ".venv", "venv", ".pytest_cache", ".mypy_cache", ".ruff_cache", "build", "dist"}

    for p in root_path.rglob("*"):
        if not p.is_file():
            continue
        if any(part in skip_dirs for part in p.parts):
            continue
        # forbidden file names
        if p.name in FORBIDDEN_FILES:
            forbidden.append(str(p))
            continue
        if any(p.name.endswith(suf) for suf in FORBIDDEN_SUFFIXES):
            forbidden.append(str(p))
            continue
        # the private design doc
        if p.name.endswith(".private.md") or "设计方案.private" in p.name:
            forbidden.append(str(p))
            continue
        # skip this scanner itself (it intentionally lists identifiers to detect)
        if p.resolve() == Path(__file__).resolve():
            continue
        # scan text content
        findings.extend(scan_file(p))

    return findings, forbidden


def main() -> int:
    ap = argparse.ArgumentParser(description="Supervisor-CAO secret / private-identifier scanner")
    ap.add_argument("root", nargs="?", default=".", help="repo root to scan")
    ap.add_argument("--strict", action="store_true", help="treat warnings as errors")
    args = ap.parse_args()

    findings, forbidden = scan_repo(args.root)
    rc = 0
    if forbidden:
        print("FORBIDDEN FILES present (must not be committed):", file=sys.stderr)
        for f in forbidden:
            print(f"  {f}", file=sys.stderr)
        rc = 1
    if findings:
        print("SECRET / PRIVATE-IDENTIFIER FINDINGS:", file=sys.stderr)
        for f in findings:
            print(f"  {f}", file=sys.stderr)
        rc = 1
    if rc == 0:
        print(f"scan-secrets: clean ({args.root})")
    return rc


if __name__ == "__main__":
    sys.exit(main())
