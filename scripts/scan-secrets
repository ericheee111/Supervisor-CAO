#!/usr/bin/env python3
"""scan-secrets: pre-push secret / private-identifier scanner.

Generic, project-agnostic. Blocks push if it finds:
  - common API key formats (OpenAI, AWS, GitHub, Google, generic, Bearer)
  - private identifiers loaded from a local (gitignored) file
  - private path patterns loaded from the same local file
  - .env, secrets.env, *.local.yaml, *.private.md, credential files

Private identifiers (real host names, container names, usernames, real paths)
must NEVER be hard-coded in this public scanner. They are read at runtime from::

    ~/.config/supervisor-cao/private-identifiers.txt

(one identifier per line; ``#`` comments and blank lines ignored). If that file
is absent, only generic secret patterns are checked.

Exit 0 = clean, exit 1 = leak found (blocks push).
Designed to have NO third-party deps (gitleaks optional; this is the fallback).
"""
from __future__ import annotations

import argparse
import re
import subprocess
import sys
from pathlib import Path

# --- Generic secret patterns (no project-specific identifiers) ---
SECRET_PATTERNS = [
    (re.compile(r"sk-[A-Za-z0-9]{20,}"), "OpenAI-style API key (sk-)"),
    (re.compile(r"AKIA[0-9A-Z]{16}"), "AWS access key ID"),
    (re.compile(r"(?i)api[_-]?key\s*[:=]\s*['\"][A-Za-z0-9_\-]{16,}['\"]"), "generic api_key assignment"),
    (re.compile(r"gh[pousr]_[A-Za-z0-9]{36,}"), "GitHub token (ghp_/gho_/ghu_/ghs_/ghr_)"),
    (re.compile(r"AIza[0-9A-Za-z_\-]{35}"), "Google API key"),
    (re.compile(r"(?i)bearer\s+[A-Za-z0-9_\-\.]{20,}"), "Bearer token"),
]

# --- Files that must never be committed ---
FORBIDDEN_FILES = [
    ".env", "secrets.env", "auth.json", "opencode.jsonc",
    "oh-my-openagent.json", "config.toml",
]
FORBIDDEN_SUFFIXES = [".local.yaml", ".local.yml", ".local.json", ".private.md"]

PRIVATE_IDENTIFIERS_FILE = Path.home() / ".config" / "supervisor-cao" / "private-identifiers.txt"


def _load_private_identifiers() -> tuple[list[str], list[str]]:
    """Load private identifiers and private path patterns from the local file.

    Returns (identifiers, path_patterns). Both empty if the file is absent.
    Lines starting with ``path:`` are treated as regex path patterns; the rest
    are plain substring identifiers.
    """
    idents: list[str] = []
    paths: list[str] = []
    if not PRIVATE_IDENTIFIERS_FILE.exists():
        return idents, paths
    try:
        for line in PRIVATE_IDENTIFIERS_FILE.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("path:"):
                pat = line[len("path:"):].strip()
                if pat:
                    paths.append(pat)
            else:
                idents.append(line)
    except OSError:
        pass
    return idents, paths


def scan_file(path: Path, idents: list[str], path_re: re.Pattern | None) -> list[str]:
    """Return list of findings (strings) for a file."""
    findings: list[str] = []
    try:
        text = path.read_text(encoding="utf-8", errors="strict")
    except (UnicodeDecodeError, ValueError):
        return []
    except OSError:
        return []

    for pat, label in SECRET_PATTERNS:
        for m in pat.finditer(text):
            findings.append(f"{path}: secret pattern {label}: {m.group(0)[:20]}...")
    for ident in idents:
        if ident and ident in text:
            findings.append(f"{path}: private identifier '{ident}'")
    if path_re is not None:
        for m in path_re.finditer(text):
            findings.append(f"{path}: private path leak '{m.group(0)}'")
    return findings


def _tracked_files(root: Path) -> list[Path]:
    """Return tracked files via ``git ls-files``. Falls back to rglob on error.

    Per spec: scanner prefers ``git ls-files`` so only tracked files are scanned,
    but does NOT skip the tests/ directory.
    """
    try:
        r = subprocess.run(
            ["git", "-C", str(root), "ls-files"],
            capture_output=True, text=True, timeout=30,
        )
        if r.returncode == 0:
            return [root / f for f in r.stdout.splitlines() if f]
    except (subprocess.SubprocessError, OSError):
        pass
    # fallback: rglob with common skip dirs
    skip_dirs = {".git", "__pycache__", ".cache", "cao-src", "wheels", "node_modules",
                 ".venv", "venv", ".pytest_cache", ".mypy_cache", ".ruff_cache", "build", "dist"}
    out: list[Path] = []
    for p in root.rglob("*"):
        if p.is_file() and not any(part in skip_dirs for part in p.parts):
            out.append(p)
    return out


def scan_repo(root: str) -> tuple[list[str], list[str]]:
    """Scan a repo root. Returns (file_findings, forbidden_file_list)."""
    root_path = Path(root)
    findings: list[str] = []
    forbidden: list[str] = []
    idents, path_patterns = _load_private_identifiers()
    path_re = re.compile("|".join(path_patterns)) if path_patterns else None

    for p in _tracked_files(root_path):
        if not p.exists():
            continue
        # forbidden file names
        if p.name in FORBIDDEN_FILES:
            forbidden.append(str(p))
            continue
        if any(p.name.endswith(suf) for suf in FORBIDDEN_SUFFIXES):
            forbidden.append(str(p))
            continue
        # the private design doc
        if p.name.endswith(".private.md") or "设计方案.private" in p.name:
            forbidden.append(str(p))
            continue
        # skip this scanner itself (it intentionally lists patterns to detect)
        try:
            if p.resolve() == Path(__file__).resolve():
                continue
        except OSError:
            pass
        # scan text content
        findings.extend(scan_file(p, idents, path_re))

    return findings, forbidden


def main() -> int:
    ap = argparse.ArgumentParser(description="Supervisor-CAO secret / private-identifier scanner")
    ap.add_argument("root", nargs="?", default=".", help="repo root to scan")
    ap.add_argument("--strict", action="store_true", help="treat warnings as errors")
    args = ap.parse_args()

    findings, forbidden = scan_repo(args.root)
    rc = 0
    if forbidden:
        print("FORBIDDEN FILES present (must not be committed):", file=sys.stderr)
        for f in forbidden:
            print(f"  {f}", file=sys.stderr)
        rc = 1
    if findings:
        print("SECRET / PRIVATE-IDENTIFIER FINDINGS:", file=sys.stderr)
        for f in findings:
            print(f"  {f}", file=sys.stderr)
        rc = 1
    if rc == 0:
        print(f"scan-secrets: clean ({args.root})")
    return rc


if __name__ == "__main__":
    sys.exit(main())
