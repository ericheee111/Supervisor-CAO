#!/usr/bin/env bash
# supervisor-cao: launcher that runs the Python CLI via the WSL/Python environment.
# On WSL2, runs the module directly. On Windows, delegates to WSL.
set -e
# resolve symlinks so the script works from /usr/local/bin
SELF="$0"
while [ -L "$SELF" ]; do SELF="$(readlink -f "$SELF")"; done
HERE="$(cd "$(dirname "$SELF")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
export PYTHONPATH="$REPO/src:${PYTHONPATH:-}"
if [ -n "$WSL_DISTRO_NAME" ] || grep -qi microsoft /proc/version 2>/dev/null; then
    # we are in WSL
    exec python3 -m supervisor_cao.cli.main "$@"
else
    # Windows host: delegate to WSL, forwarding the repo path
    WSL_REPO=$(wslpath -a "$REPO" 2>/dev/null || echo "$REPO")
    exec wsl.exe -d Ubuntu-24.04 bash -lc "cd '$WSL_REPO' && PYTHONPATH='$WSL_REPO/src' python3 -m supervisor_cao.cli.main $*"
fi
